# systemd unit for running pyPodOut fullscreen on a Raspberry Pi console (no desktop).
#
# Edit User/WorkingDirectory to match your install, then:
#   sudo cp deploy/podout.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now podout
#
# The user must be in the video, render and input groups:
#   sudo usermod -aG video,render,input pi

[Unit]
Description=pyPodOut (iPod Out recreation)
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pyPodOut
Environment=SDL_VIDEODRIVER=kmsdrm
# Use the GLES2 renderer explicitly; SDL's default pick fails with "EGL not initialized" on a Pi 3.
Environment=SDL_RENDER_DRIVER=opengles2
Environment=FULLSCREEN=1
ExecStart=/usr/bin/python3 -u main.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
